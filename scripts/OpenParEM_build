cp OpenParEM2D_save.py "$HOME/.FreeCAD/Macro"

echo "copy FreeCAD/OpenParEM3D_save.py to $HOME/.FreeCAD/Macro"
cp OpenParEM3D_save.py "$HOME/.FreeCAD/Macro"

# ParaView

