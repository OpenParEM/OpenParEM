#----------------------------------------------------
# subroutines
#----------------------------------------------------

scripts_dir=$PWD

# unpack file name for external packages
FILE_base=""

# unpack a tarball and cd to the directory
unpack_and_enter() {

   FILE=$1

   # check for existence
   if [ ! -f "$FILE" ]; then
      echo "ERROR: distribution \"""$FILE""\" not found in $PWD"
      exit 1
   fi

   # determine type and base name

   is_identified=0

   is_targz=0
   if [ "$is_identified" = "0" ]; then
      FILE_base=${FILE%.tar.gz}
      if [ "$FILE_base" != "$FILE" ]; then
         is_targz=1
         is_identified=1
      fi
   fi

   is_tarxz=0
   if [ "$is_identified" = "0" ]; then
      FILE_base=${FILE%.tar.xz}
      if [ "$FILE_base" != "$FILE" ]; then
         is_tarxz=1
         is_identified=1
      fi
   fi

   is_tgz=0
   if [ "$is_identified" = "0" ]; then
      FILE_base=${FILE%.tgz}
      if [ "$FILE_base" != "$FILE" ]; then
         is_tgz=1
         is_identified=1
      fi
   fi

   is_zip=0
   if [ "$is_identified" = "0" ]; then
      FILE_base=${FILE%.zip}
      if [ "$FILE_base" != "$FILE" ]; then
         is_zip=1
         is_identified=1
      fi
   fi

   if [ "$is_identified" = "0" ]; then
      echo "ERROR: unrecognized distribution for \"""$FILE""\""
      exit 1
   fi

   # tcl and tk add "-src" to the tarball name that must be removed to get the correct base name

   prefix=`echo $FILE_base | cut -c1-3`
   if [ "$prefix" = "tcl" ]; then
      FILE_base=${FILE_base%-src}
   fi

   prefix=`echo $FILE_base | cut -c1-2`
   if [ "$prefix" = "tk" ]; then
      FILE_base=${FILE_base%-src}
   fi

   # remove any previously unpacked instance
   if [ -d "$FILE_base" ]; then
      rm -Rf "$FILE_base"
      if [ $? -ne 0 ]; then
         echo "ERROR: unable to remove directory \"""$FILE_base""\""
      fi
   fi

   # unpack

   if [ "$is_targz" = "1" -o "$is_tgz" = "1" -o "$is_tarxz" = "1" ]; then
      tar -xf "$FILE"
      if [ $? -ne 0 ]; then
         echo "ERROR: failure to unpack \"""$FILE""\""
         exit 1
      fi
   fi

   if [ "$is_zip" = "1" ]; then
      unzip "$FILE"
      if [ $? -ne 0 ]; then
         echo "ERROR: failure to unpack \"""$FILE""\""
         exit 1
      fi
   fi

   # make sure it unpacked
   if [ ! -d "$FILE_base" ]; then
      echo "ERROR: failure to unpack \"""$FILE""\""
      exit 1
   fi

   cd "$FILE_base"
}

remove_base_directory() {
   if [ -d "$FILE_base" ]; then
      rm -Rf "$FILE_base"
      if [ $? -ne 0 ]; then
         echo "ERROR: failed to remove directory \"""$FILE_base""\""
         exit 1
      fi
   else 
      echo "ERROR: failed to find directory \"""$FILE_base""\""
      exit 1
   fi
}

wrap_executable() {

   echo "wrapping $1"

   # executable to wrap
   PROG=$1
   BINPROG=$PROG.bin

   # flag for processing for OPENMPI
   HAS_COMPILED_OPENMPI=$2

   # delete the log file
   REMOVE_LOGFILE=$3

   # redirect stdout/stderr to a log file
   TEST_REDIRECT=$4

   cd "$install_path/bin"

      if [ $? -ne 0 ]; then
         echo "ERROR: failed to change to the bin directory"
         exit 1
      fi

      mv $PROG $BINPROG
      if [ $? -ne 0 ]; then
         echo "ERROR: failed to move $PROG to $BINPROG"
         exit 1
      fi

      echo '#!/bin/sh' > $PROG
      if [ $? -ne 0 ]; then
         echo "ERROR: failed to create $PROG"
         exit 1
      fi

      echo '' >> $PROG
      if [ "$TEST_REDIRECT" = "1" ]; then
         echo "# usage: $PROG [-h|--help] project_name log_file_name" >> $PROG
         echo '#        project_name is required and requires an extension' >> $PROG
         echo '#        log_file_name is optional' >> $PROG
         echo '# ' >> $PROG
         echo '# Output to the terminal is redirected to a log file, where' >> $PROG
         echo "# the file name is either log_file_name or $PROG.log if log_file_name is not provided." >> $PROG
         echo '# ' >> $PROG
         echo '# If -h or --help are given, then a short help message is printed to the terminal' >> $PROG
         echo '# followed by immediate exit.' >> $PROG
      else
         echo "# usage: $PROG file_name" >> $PROG
         echo '#        file_name is required' >> $PROG
      fi

      echo '' >> $PROG
      echo "BINPROG=$BINPROG" >> $PROG
      echo 'BINPATH=$(which $BINPROG)' >> $PROG
      echo 'if [ "$BINPATH" = "" ]; then' >> $PROG
      echo '   echo "ERROR: Failed to locate $BINPROG."' >> $PROG
      echo '   exit 1' >> $PROG
      echo 'fi' >> $PROG

      if [ "$TEST_REDIRECT" = "1" ]; then
         echo '' >> $PROG
         echo 'if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then' >> $PROG
         echo '   $BINPROG "$1"' >> $PROG
         echo '   exit 0' >> $PROG
         echo 'fi' >> $PROG
      fi

      echo 'OPEM=${BINPATH%/bin/$BINPROG}' >> $PROG

      echo '' >> $PROG
      echo 'export LD_LIBRARY_PATH=$OPEM/lib:$OPEM/lib64:$LD_LIBRARY_PATH' >> $PROG
      if [ "$HAS_COMPILED_OPENMPI" = "1" ]; then
         echo 'export OPAL_PREFIX=$OPEM' >> $PROG
         echo 'export PMIX_PREFIX=$OPEM' >> $PROG
      fi
      echo 'export OMP_NUM_THREADS=1' >> $PROG
      echo 'export QT_QPA_PLATFORM=xcb' >> $PROG
      echo 'export QT_QPA_PLATFORMTHEME=generic' >> $PROG


      # create a default log file name if one is not provided
      # default is to remove any exension and add .log (aligned with OpenParEM3D)
      echo '' >> $PROG
      echo 'if [ "$2" = "" ]; then' >> $PROG
      echo "   LOGFILE=\`expr \"\$1\" : '\\(.*\\)\\.[^.]*\$'\`.log" >> $PROG
      echo 'else' >> $PROG
      echo '   LOGFILE="$2"' >> $PROG
      echo 'fi' >> $PROG
      echo '' >> $PROG


      echo '' >> $PROG
      echo 'HASLOGFILE=0' >> $PROG
      echo 'if [ "$2" != "" ]; then' >> $PROG
      echo '   HASLOGFILE=1' >> $PROG
      echo 'fi' >> $PROG
      echo '' >> $PROG

      if [ "$REMOVE_LOGFILE" = "1" ]; then
         echo 'if [ -n "$OMPI_COMM_WORLD_RANK" ]; then' >> $PROG
         echo '     # Open MPI' >> $PROG
         echo '    RANK=$OMPI_COMM_WORLD_RANK' >> $PROG
         echo 'elif [ -n "$PMI_RANK" ]; then' >> $PROG
         echo '    # MPICH, Intel MPI, many PMI-based launchers' >> $PROG
         echo '    RANK=$PMI_RANK' >> $PROG
         echo 'elif [ -n "$MPI_RANKID" ]; then' >> $PROG
         echo '    # Some older MPICH / platform MPI variants' >> $PROG
         echo '    RANK=$MPI_RANKID' >> $PROG
         echo 'elif [ -n "$SLURM_PROCID" ]; then' >> $PROG
         echo '    # Slurm srun' >> $PROG
         echo '    RANK=$SLURM_PROCID' >> $PROG
         echo 'else' >> $PROG
         echo '    RANK=0' >> $PROG
         echo 'fi' >> $PROG
         echo '' >> $PROG
         echo 'if [ "$RANK" = "0" ]; then' >> $PROG
         echo '   rm -f "$LOGFILE"' >> $PROG
         echo 'fi' >> $PROG
         echo '' >> $PROG
      fi

      if [ "$TEST_REDIRECT" = "1" ]; then
         echo 'if [ "$HASLOGFILE" = "1" ]; then' >> $PROG
         echo '   $BINPROG "$@" >> "$LOGFILE" 2>&1' >> $PROG
         echo 'else' >> $PROG
         echo '   $BINPROG "$@"' >> $PROG
         echo 'fi' >> $PROG
      else
         echo '$BINPROG "$@"' >> $PROG
      fi

      chmod u+x $PROG
      if [ $? -ne 0 ]; then
         echo "ERROR: failed make $PROG executable"
         exit 1
      fi

   cd "$scripts_dir"
}

