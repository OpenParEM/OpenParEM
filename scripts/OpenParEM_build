# OpenParEM
if [ "$with_OpenParEM" = "1" ]; then

   echo "#------------------------------------------------------------------------------------"
   echo "# OpenParEM_build: OpenParEM"
   echo "#------------------------------------------------------------------------------------"

   cd src

   make clean
   if [ $? -ne 0 ]; then
      echo "OpenParEM_INFO: OpenParEM failed to make clean"
   fi

   ./configure --prefix="$install_path"
   if [ $? -ne 0 ]; then
      echo "OpenParEM_ERROR: OpenParEM failed to configure"
      exit 1
   fi

   make -j "$jobs"
   if [ $? -ne 0 ]; then
      echo "OpenParEM_ERROR: OpenParEM failed to make"
      exit 1
   fi

   make install
   if [ $? -ne 0 ]; then
      echo "OpenParEM_ERROR: OpenParEM failed to install"
      exit 1
   fi

   make check
   if [ $? -ne 0 ]; then
      echo "OpenParEM_ERROR: OpenParEM failed to check"
      exit 1
   fi

   cd ..
fi

# OpenParEMg
if [ "$with_OpenParEMg" = "1" ]; then

   echo "#------------------------------------------------------------------------------------"
   echo "# OpenParEM_build: OpenParEMg"
   echo "#------------------------------------------------------------------------------------"

   cd src/OpenParEMg

   rm -Rf build2
   mkdir build2
   if [ $? -ne 0 ]; then
      echo "OpenParEM_ERROR: OpenParEMg failed to create a build directory"
      exit 1
   fi

   APP_SOURCE="$SCRIPT_DIR/../src/OpenParEMg"
   APP_BUILD="$SCRIPT_DIR/../src/OpenParEMg/build2"

   cmake -S "$APP_SOURCE" \
         -B "$APP_BUILD" \
         -DCMAKE_BUILD_TYPE=Release \
         -DCMAKE_INSTALL_PREFIX="$install_path" \
         -DCMAKE_PREFIX_PATH="$install_path" \
         || exit 1

   cmake --build "$APP_BUILD" -j"$NPROC" || exit 1

   cmake --install "$APP_BUILD" || exit 1

   cd ../..
fi

cd scripts

echo "#------------------------------------------------------------------------------------"
echo "# OpenParEM_build: creating wrappers for executables"
echo "#------------------------------------------------------------------------------------"

# see if a compiled version of Open MPI exists
cd "$install_path/bin"
   if [ $? -ne 0 ]; then
      echo "OpenParEM_ERROR: failed to change to bin directory."
      exit 1
   fi

   HAS_ORTERUN=0
   if [ -f orterun ]; then
      HAS_ORTERUN=1
   fi

   HAS_ORTERUNBIN=0
   if [ -f orterun.bin ]; then
      HAS_ORTERUNBIN=1
   fi

   HAS_MPIRUNBIN=0
   if [ -f mpirun.bin ]; then
      HAS_MPIRUNBIN=1
   fi

cd "$scripts_dir"

if [ "$with_OpenParEM" = "1" ]; then
   #wrap_executable builder $HAS_ORTERUN 0 0
   wrap_executable OpenParEM2D $HAS_ORTERUN 0 1
   #wrap_executable process2D $HAS_ORTERUN 0 0
   #wrap_executable simplify2D $HAS_ORTERUN 0 0
   wrap_executable OpenParEM3D $HAS_ORTERUN 1 1
   #wrap_executable process3D $HAS_ORTERUN 0 0
   #wrap_executable simplify3D $HAS_ORTERUN 0 0
fi

if [ "$with_OpenParEMg" = "1" ]; then
   wrap_executable OpenParEMg $HAS_ORTERUN 1 1
fi


# find which MPI library is being used
HAS_OPENMPI=0
HAS_MPICH=0
which mpirun > /dev/null 2>&1
if [ $? -eq 0 ]; then
   output=$(mpirun --version 2>/dev/null)

   echo "$output" | grep -qi "Open MPI"
   if [ $? -eq 0 ]; then
      HAS_OPENMPI=1
   fi

   echo "$output" | grep -qi "MPICH"
   if [ $? -eq 0 ]; then
      HAS_MPICH=1
   fi
fi

# wrapping for OpenMPI
if [ "$HAS_OPENMPI" = "1" ]; then 
   if [ "$HAS_ORTERUN" = "1" ]; then
      if [ "$HAS_ORTERUNBIN" = "0" ]; then
         wrap_executable orterun $HAS_ORTERUN 0 0
      fi
   else
      cd "$install_path/bin"
      if [ $? -ne 0 ]; then
         echo "OpenParEM_ERROR: failed to change to bin directory."
         exit 1
      fi

      if [ ! -f orterun ]; then

         rm -f mpirun
         echo "#!/bin/sh" > mpirun
         if [ $? -ne 0 ]; then
            echo "OpenParEM_ERROR: failed to create file mpirun."
            exit 1
         fi

         echo 'export OMP_NUM_THREADS=1' >> mpirun
         echo 'orterun "$@"' >> mpirun

      fi

      cd "$scripts_dir"
   fi
fi

# wrapping for MPICH
if [ "$HAS_MPICH" = "1" ]; then
   if [ "$HAS_MPIRUNBIN" = "0" ]; then
      wrap_executable mpirun 0 0 0
   fi
fi

# finish up with elapsed time
end_time="$(date -u +%s)"
elapsed=$(( end_time - start_time ))
echo "OpenParEM_build elapsed time (s): $elapsed"

exit 0
