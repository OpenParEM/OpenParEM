   remove_base_directory
   cd ..
fi


# meson and ninja
if [ "$with_meson" = "1" ]; then

   echo "#------------------------------------------------------------------------------------"
   echo "# OpenParEM_build: ninja"
   echo "#------------------------------------------------------------------------------------"

   cd external_packages

   unpack_and_enter $ninja

   ./configure.py --bootstrap
   if [ $? -ne 0 ]; then
      echo "OpenParEM_ERROR: ninja failed to build"
      exit 1
   fi

   cp ninja "$install_path/bin"

   cd ..
   remove_base_directory
   cd ..

   echo "#------------------------------------------------------------------------------------"
   echo "# OpenParEM_build: meson"
   echo "#------------------------------------------------------------------------------------"

   cd external_packages

   unpack_and_enter $meson

   python3 packaging/create_zipapp.py --outfile="$install_path/bin/meson" --interpreter='/usr/bin/env python3'

   chmod +x "$install_path/bin/meson"

   cd ..
   remove_base_directory
   cd ..



fi

