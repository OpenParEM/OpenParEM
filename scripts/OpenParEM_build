#----------------------------------------------------
# download required packages
#----------------------------------------------------

download_package_and_verify_sha ()
{
    PACKAGE="$1"
    URL="$2"
    EXPECTED_SHA="$3"

    FILE="$DOWNLOAD_DIR/$PACKAGE"

    if [ ! -f "$FILE" ]; then
        echo "Downloading package file $PACKAGE ..."
        wget -O "$FILE" "$URL" || return 1
    fi

    echo "Verifying SHA for $PACKAGE ..."

    ACTUAL_SHA=$(shasum "$FILE" | awk '{print $1}')

    if [ "$ACTUAL_SHA" != "$EXPECTED_SHA" ]; then
        echo "ERROR: SHA mismatch for $PACKAGE"
        echo "Expected: $EXPECTED_SHA"
        echo "Actual:   $ACTUAL_SHA"
        return 1
    fi

    echo "SHA OK: $PACKAGE"
    echo ""
}

download_package_and_verify_sha256 ()
{
    PACKAGE="$1"
    URL="$2"
    EXPECTED_SHA256="$3"

    FILE="$DOWNLOAD_DIR/$PACKAGE"

    if [ ! -f "$FILE" ]; then
        echo "Downloading package file $PACKAGE ..."
        wget -O "$FILE" "$URL" || return 1
    fi

    echo "Verifying SHA-256 for $PACKAGE ..."

    ACTUAL_SHA256=$(sha256sum "$FILE" | awk '{print $1}')

    if [ "$ACTUAL_SHA256" != "$EXPECTED_SHA256" ]; then
        echo "ERROR: SHA-256 mismatch for $PACKAGE"
        echo "Expected: $EXPECTED_SHA256"
        echo "Actual:   $ACTUAL_SHA256"
        return 1
    fi

    echo "SHA-256 OK: $PACKAGE"
    echo ""
}

download_package_and_verify_sig ()
{
    PACKAGE="$1"
    URL="$2"
    SIG_SUFFIX="${3:-sig}"
    KEYRING="$4"
    SITE_SUFFIX="$5"

    FILE="$DOWNLOAD_DIR/$PACKAGE"
    SIG="$FILE.$SIG_SUFFIX"

    if [ ! -f "$FILE" ]; then
        echo "Downloading package file $PACKAGE ..."
        wget -O "$FILE" "${URL}$SITE_SUFFIX" || return 1
    fi

    #echo "List of keys for $KEYRING:"
    #gpg --no-default-keyring \
    #    --keyring "$KEYRING" \
    #    --list-keys

    if [ ! -f "$SIG" ]; then
        echo "Downloading sig file $PACKAGE.$SIG_SUFFIX ..."
        wget -O "$SIG" "${URL}.$SIG_SUFFIX$SITE_SUFFIX" || return 1
    fi

    echo "Verifying $PACKAGE ..."
    gpgv --keyring "$KEYRING" "$SIG" "$FILE" || return 1

    echo "Signature OK: $PACKAGE"
    echo ""
}

