   cd external_packages

   unpack_and_enter "$openmpi"

   ./configure --prefix="$install_path" --enable-static="$enable_static" --enable-shared="$enable_shared" --with-libevent="$install_path" --with-hwloc="$install_path" --with-pmix="$install_path"
   if [ $? -ne 0 ]; then
      echo "OpenParEM_ERROR: openmpi failed to configure"
      exit 1
   fi

   make -j "$jobs"
   if [ $? -ne 0 ]; then
      echo "OpenParEM_ERROR: openmpi failed to make"
      exit 1
   fi

   make install
   if [ $? -ne 0 ]; then
      echo "OpenParEM_ERROR: openmpi failed to install"
      exit 1
   fi

   cd ..
   remove_base_directory
   cd ..

fi

# mpich
if [ "$with_mpich" = "1" ]; then

   echo "#------------------------------------------------------------------------------------"
   echo "# OpenParEM_build: mpich"
   echo "#------------------------------------------------------------------------------------"

   cd external_packages

   unpack_and_enter "$mpich"

   # The device has a large impact on performance that is hardware dependent.  Experimentation is in order.

   # configure selects the device
   # extremely slow in eigenvalue solve when excessive slots are specified
   # <10% slower than with ch3:nemesis on normal run
   #./configure --prefix="$install_path" --enable-static="$enable_static" --enable-shared="$enable_shared" 

   # good on the eigenvalue solve when excessive slots are speccified
   # but 50% slower on small cases
   #./configure --prefix="$install_path" --enable-static="$enable_static" --enable-shared="$enable_shared" --with-device=ch3:sock

   # extremely slow in eigenvalue solve when excessive slots are specified
   #./configure --prefix="$install_path" --enable-static="$enable_static" --enable-shared="$enable_shared" --with-device=ch3:nemesis

   # not supported
   #./configure --prefix="$install_path" --enable-static="$enable_static" --enable-shared="$enable_shared" --with-device=ch4:nemsis

   # extremely slow in eigenvalue solve when excessive slots are specified
   # faster than OpenMPI for a small case
   ./configure --prefix="$install_path" --enable-static="$enable_static" --enable-shared="$enable_shared" --with-device=ch4:ucx

   # extremely slow in eigenvalue solve when excessive slots are specified
   # <10% slower than OpenMPI for a small case
   #./configure --prefix="$install_path" --enable-static="$enable_static" --enable-shared="$enable_shared" --with-device=ch4:ofi


   if [ $? -ne 0 ]; then
      echo "OpenParEM_ERROR: mpich failed to configure"
      exit 1
   fi

   make -j "$jobs"
   if [ $? -ne 0 ]; then
      echo "OpenParEM_ERROR: mpich failed to make"
      exit 1
   fi

   make install
   if [ $? -ne 0 ]; then
      echo "OpenParEM_ERROR: mpich failed to install"
      exit 1
   fi

   cd ..
   remove_base_directory
   cd ..

fi

