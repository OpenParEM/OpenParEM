   mkdir build
   if [ $? -ne 0 ]; then
      echo "OpenParEM_ERROR: gmsh failed to create a build directory"
      exit 1
   fi

   cd build

   #../configure --prefix="$install_path" --skip qtconnectivity,qtsensors,qtserialport,qtserialbus,qtpositioning,qtlocation,qtwebengine,qtmultimedia,qtwebsockets,qtsql,qtremoteobjects,qtpurchase,qtquick3d,qtquicktimeline,qtsvg,qtquick3dphysics,qtspeech,qtvirtualkeyboard
   ../configure --prefix="$install_path"
   if [ $? -ne 0 ]; then
      echo "OpenParEM_ERROR: qt failed to configure"
      exit 1
   fi

   cmake --build . --parallel "$jobs"
   if [ $? -ne 0 ]; then
      echo "OpenParEM_ERROR: qt failed to make"
      exit 1
   fi

   cmake --install .
   if [ $? -ne 0 ]; then
      echo "OpenParEM_ERROR: qt failed to install"
      exit 1
   fi

