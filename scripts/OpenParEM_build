# tcl
if [ "$with_tcl" = "1" ]; then

   echo "#------------------------------------------------------------------------------------"
   echo "# OpenParEM_build: tcl"
   echo "#------------------------------------------------------------------------------------"

   cd external_packages

   unpack_and_enter "$tcl"
 
   cd unix

   ./configure --prefix="$install_path"
   if [ $? -ne 0 ]; then
      echo "OpenParEM_ERROR: tcl failed to configure"
      exit 1
   fi

   make -j "$jobs"
   if [ $? -ne 0 ]; then
      echo "OpenParEM_ERROR: tcl failed to make"
      exit 1
   fi

   make install
   if [ $? -ne 0 ]; then
      echo "OpenParEM_ERROR: tcl failed to install"
      exit 1
   fi


   cd ../..
   remove_base_directory
   cd ..

   # put a soft link to the versioned tclsh

   current_dir=$PWD

   if [ ! -d $install_path/bin ]; then
      echo "OpenParEM_ERROR: tcl failed to find install directory"
      exit 1
   fi

   cd $install_path/bin

   if [ -f tclsh ]; then
      rm tclsh
   fi

   tclsh=`ls tcl*`
   if [ ! -f "$tclsh" ]; then
      echo "OpenParEM_ERROR: tcl failed to find tclsh"
      exit 1
   fi

   ln -s $tclsh tclsh
   if [ $? -ne 0 ]; then
      echo "OpenParEM_ERROR: tcl failed to softlink tclsh"
      exit 1
   fi

   cd $current_dir
fi

# tk
if [ "$with_tk" = "1" ]; then 

   echo "#------------------------------------------------------------------------------------"
   echo "# OpenParEM_build: tk"
   echo "#------------------------------------------------------------------------------------"

   cd external_packages

   unpack_and_enter "$tk"

   cd unix

   ./configure CPPFLAGS="-I$install_path/include" --prefix="$install_path" --with-tcl=$install_path/lib
   if [ $? -ne 0 ]; then 
      echo "OpenParEM_ERROR: tk failed to configure"
      exit 1  
   fi

   make -j "$jobs" 
   if [ $? -ne 0 ]; then 
      echo "OpenParEM_ERROR: tk failed to make"
      exit 1  
   fi

   make install 
   if [ $? -ne 0 ]; then 
      echo "OpenParEM_ERROR: tk failed to install"
      exit 1  
   fi

   cd ../.. 
   remove_base_directory
   cd .. 

   # put a soft link to the versioned wish

   current_dir=$PWD

   if [ ! -d $install_path/bin ]; then
      echo "OpenParEM_ERROR: tk failed to find install directory"
      exit 1
   fi

   cd $install_path/bin

   if [ -f wish ]; then
      rm wish
   fi

   wish=`ls wish*`
   if [ ! -f "$wish" ]; then
      echo "OpenParEM_ERROR: tk failed to find wish"
      exit 1
   fi

   ln -s $wish wish
   if [ $? -ne 0 ]; then
      echo "OpenParEM_ERROR: tk failed to softlink wish"
      exit 1
   fi

   cd $current_dir
  
fi

# zlib
if [ "$with_zlib" = "1" ]; then

   echo "#------------------------------------------------------------------------------------"
   echo "# OpenParEM_build: zlib"
   echo "#------------------------------------------------------------------------------------"

   cd external_packages

   unpack_and_enter "$zlib"

   if [ "$enable_static" = "yes" ]; then 
      ./configure --static --prefix="$install_path"
      if [ $? -ne 0 ]; then
         echo "OpenParEM_ERROR: zlib failed to configure"
         exit 1
      fi
   else
      ./configure --prefix="$install_path"
      if [ $? -ne 0 ]; then
         echo "OpenParEM_ERROR: zlib failed to configure"
         exit 1
      fi
   fi

   make -j "$jobs"
   if [ $? -ne 0 ]; then
      echo "OpenParEM_ERROR: zlib failed to make"
      exit 1
   fi

   make install
   if [ $? -ne 0 ]; then
      echo "OpenParEM_ERROR: zlib failed to install"
      exit 1
   fi

   cd ..
   remove_base_directory
   cd ..
fi

