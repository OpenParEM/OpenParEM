   echo "# OpenParEM_build: libxml2"
   echo "#------------------------------------------------------------------------------------"

   cd external_packages

   unpack_and_enter $libxml2
   package_name=libxml2

   mkdir build
   cd build

   cmake .. \
    -DCMAKE_INSTALL_PREFIX="$install_path" \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=OFF

   cmake --build . -j "$jobs"
   cmake --install .

   cd ../..
   remove_base_directory
   cd ..

   echo "#------------------------------------------------------------------------------------"
   echo "# OpenParEM_build: xkbcommon"
   echo "#------------------------------------------------------------------------------------"

   cd external_packages

   unpack_and_enter $xkbcommon
   package_name=xkbcommon

   meson setup build --prefix="$install_path" -Denable-wayland=false -Denable-bash-completion=false
   if [ $? -ne 0 ]; then
      echo "OpenParEM_ERROR: xkbcommon failed to setup build"
      exit 1
   fi

   meson compile -C build
   if [ $? -ne 0 ]; then
      echo "OpenParEM_ERROR: xkbcommon failed to compile"
      exit 1
   fi


   #meson test -C build 
   #if [ $? -ne 0 ]; then
